# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.VOTREDOMAINE.fr
NEXT_PUBLIC_SITE_NAME=RegardezIPTV

# Analytics (Optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=regardeziptv.fr
NEXT_PUBLIC_PLAUSIBLE_URL=https://plausible.io/js/script.js

# CMS Authentication (change in production!)
CMS_AUTH_SECRET=your-secret-key-change-in-production

# BSD Sports API (Bzzoiro Sports Data) — REQUIRED for /programme-sports live scores
# Get your free key at: https://bzzoiro.com/sports
# IMPORTANT: server-side only — NEVER prefix with NEXT_PUBLIC_
BSD_SPORTS_API_KEY=your-bsd-api-key-here

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=cms_db
